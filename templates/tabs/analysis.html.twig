{% set can_edit = item.canUpdateItem() %}

<form method="post" action="{{ path('/plugins/securityincidents/front/securityincident.form.php') }}">
  {{ csrf_field() }}
  <input type="hidden" name="id" value="{{ item.getID() }}">

  <div class="mb-3">
    <label class="form-label">{{ __('Impact', 'securityincidents') }}</label>
    {% if can_edit %}
      <textarea name="impact_content" class="form-control" rows="4">{{ item.fields.impact_content }}</textarea>
    {% else %}
      <div class="form-control-plaintext">{{ item.fields.impact_content|nl2br }}</div>
    {% endif %}
  </div>

  <div class="mb-3">
    <label class="form-label">{{ __('Controls applied / to apply', 'securityincidents') }}</label>
    {% if can_edit %}
      <textarea name="control_list_content" class="form-control" rows="4">{{ item.fields.control_list_content }}</textarea>
    {% else %}
      <div class="form-control-plaintext">{{ item.fields.control_list_content|nl2br }}</div>
    {% endif %}
  </div>

  <div class="mb-3">
    <label class="form-label">{{ __('Rollback / containment plan', 'securityincidents') }}</label>
    {% if can_edit %}
      <textarea name="rollback_plan_content" class="form-control" rows="4">{{ item.fields.rollback_plan_content }}</textarea>
    {% else %}
      <div class="form-control-plaintext">{{ item.fields.rollback_plan_content|nl2br }}</div>
    {% endif %}
  </div>

  {% if can_edit %}
    <button type="submit" name="update" class="btn btn-primary">{{ __('Save') }}</button>
  {% endif %}
</form>
