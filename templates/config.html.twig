<div class="card">
  <div class="card-body">

    <div class="card card-sm mb-3">
      <div class="card-body d-flex align-items-center gap-3">
        <i class="ti ti-brand-github fs-1 text-muted"></i>
        <div>
          <div class="fw-bold">{{ __('Plugin version', 'securityincidents') }}</div>
          <div class="text-muted small">
            {{ __('Installed version', 'securityincidents') }}
            <span class="badge bg-blue-lt">v{{ installed_version }}</span>
            {% if latest_github_version %}
              {{ __('Latest version on GitHub', 'securityincidents') }}
              <span class="badge {{ latest_github_version != installed_version ? 'bg-orange-lt' : 'bg-green-lt' }}">v{{ latest_github_version }}</span>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <div class="card card-sm">
      <div class="card-body d-flex align-items-center gap-3">
        <i class="ti ti-bell fs-1 text-muted"></i>
        <div>
          <div class="fw-bold">{{ __('Notifications') }}</div>
          <div class="text-muted small">
            {{ __('New / updated / solved / closed notifications are pre-configured at install. Customize recipients and templates from', 'securityincidents') }}
            <a href="{{ path('/front/notification.php') }}">{{ __('Setup > Notifications', 'securityincidents') }}</a>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
