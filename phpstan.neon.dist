parameters:
    level: 5
    # Scoped to src/ only (Install\Installer, Profile, Parameters\SecurityIncidentParameters) —
    # every ITIL-related class lives in inc/ under the legacy global-namespace convention (see
    # PluginSecurityincidentsSecurityIncident's own docblock for why), loaded only by GLPI's own
    # plugin-specific runtime autoloader once a plugin is active. This bootstrap only loads GLPI
    # core's composer autoload (no DB, no Kernel boot, no active-plugin awareness), so referencing
    # an inc/ class from here would be a guaranteed, unfixable "class not found" false positive —
    # excluded rather than fought with ignoreErrors across every call site.
    paths:
        - src
    bootstrapFiles:
        - .phpstan-bootstrap.php
    ignoreErrors:
        # Not scoped to one file: Install\Installer, Profile and Parameters\SecurityIncidentParameters
        # all legitimately reference PluginSecurityincidentsSecurityIncident (and its satellites) by
        # design — see the paths comment above for why this bootstrap can never resolve them, and
        # PluginSecurityincidentsSecurityIncident's own docblock for why they live outside src/ at
        # all. Every class.notFound under src/ is one of these references, never a genuine typo a
        # narrower rule would help catch.
        -
            identifier: class.notFound
            path: src
